# This .gitignore file should be placed at the root of your Unity project directory.
#
# Get latest sign-offs and recommendations:
# https://github.com/github/gitignore/blob/main/Unity.gitignore
#
Library/
Temp/
Obj/
Build/
Builds/
Logs/
UserSettings/
.vscode/
Assets/_Recovery/

# Memory dumps
*.log
*.pid
*.seed
*.pid.lock

# Gradle cache directory
.gradle/

# Asset meta files must be tracked in Unity since they contain import settings
!/[A]ssets/**/*.meta

# Unused Characteristics
/[A]ssets/AssetStoreTools*

# Visual Studio cache directory
.vs/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file redirects
*.asset.reimport

# Crashlytics generated file
crashlytics-build.properties

# Packed Modding API archives
*.meta.unity
*.unitypackage

# Builds
*.apk
*.aab
*.unitypackage
*.app
*.deploy
*.gresource

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db